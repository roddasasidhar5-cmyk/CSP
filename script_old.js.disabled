// ==================== SESSION MANAGER ====================
class SessionManager {
  constructor() {
    this.key = 'scheduledTests';
  }

  scheduleTest(testData) {
    const tests = this.getScheduledTests();
    const newTest = {
      id: Date.now().toString(),
      ...testData,
    };
    tests.push(newTest);
    localStorage.setItem(this.key, JSON.stringify(tests));
    return newTest;
  }

  getScheduledTests() {
    const tests = localStorage.getItem(this.key);
    if (!tests) return [];
    return JSON.parse(tests).sort((a, b) => new Date(a.date) - new Date(b.date));
  }

  deleteScheduledTest(testId) {
    const tests = this.getScheduledTests();
    const updated = tests.filter(t => t.id !== testId);
    localStorage.setItem(this.key, JSON.stringify(updated));
  }
}

const sessionManager = new SessionManager();

// ==================== GLOBAL STATE ====================
let testInProgress = false;
let tabSwitches = 0;
const maxTabSwitches = 3;
let testState = {
  currentQuestion: 0,
  selectedAnswers: [],
  subject: '',
  numQuestions: 0,
  startTime: null,
  duration: 0,
};

// ==================== INITIALIZATION ====================
function initializeApp() {
  setupEventListeners();
  displayAssignmentStatus();
  if (currentUser.role === 'admin') {
    displayAdminTests();
  }
  loadStats();
}

// ==================== EVENT LISTENERS ====================
function setupEventListeners() {
  // Navigation
  document.querySelectorAll('.nav-item').forEach(btn => {
    btn.addEventListener('click', handleNavigation);
  });

  // Mock test
  document.getElementById('start-test').addEventListener('click', startMockTest);
  document.getElementById('submit-test').addEventListener('click', submitTest);
  document.getElementById('reset-session').addEventListener('click', resetSession);
  document.getElementById('load-more').addEventListener('click', loadMoreQuestions);

  // Admin
  if (currentUser.role === 'admin') {
    document.getElementById('admin-schedule-form').addEventListener('submit', handleAdminScheduleSubmit);
  }
}

// ==================== NAVIGATION ====================
function handleNavigation(e) {
  const view = e.target.getAttribute('data-view');
  
  // Check if user is trying to access admin panel
  if (view === 'admin' && currentUser.role !== 'admin') {
    alert('Admin access required');
    return;
  }

  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById(view).classList.add('active');

  document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));
  e.target.classList.add('active');
}

// ==================== MOCK TEST FUNCTIONALITY ====================
function startMockTest() {
  const subject = document.getElementById('subject-select').value;
  const numQuestions = parseInt(document.getElementById('num-questions').value);

  testState.subject = subject;
  testState.numQuestions = numQuestions;
  testState.currentQuestion = 0;
  testState.selectedAnswers = new Array(numQuestions).fill(null);
  testState.startTime = Date.now();
  testState.duration = numQuestions * 2 * 60; // 2 minutes per question

  testInProgress = true;
  enableTestSecurity();

  document.getElementById('test-container').classList.remove('hidden');
  document.getElementById('test-form').innerHTML = '';
  document.getElementById('test-result').classList.add('hidden');

  displayQuestion();
  startTimer();
}

function displayQuestion() {
  const questions = questionBank[testState.subject];
  const question = questions[testState.currentQuestion];

  const questionHTML = `
    <div class="question-card">
      <div class="question-meta">
        <span>Question ${testState.currentQuestion + 1} of ${testState.numQuestions}</span>
        <span class="difficulty-${question.difficulty.toLowerCase()}">${question.difficulty}</span>
      </div>
      <p>${question.question}</p>
      <div class="answer-group">
        ${question.options
          .map(
            (option, idx) =>
              `<label>
            <input type="radio" name="answer" value="${option}" ${
                testState.selectedAnswers[testState.currentQuestion] === option ? 'checked' : ''
              } />
            <span>${option}</span>
          </label>`
          )
          .join('')}
      </div>
    </div>
  `;

  document.getElementById('test-form').innerHTML = questionHTML;
  updateProgress();

  // Save answer on change
  document.querySelectorAll('input[name="answer"]').forEach(input => {
    input.addEventListener('change', (e) => {
      testState.selectedAnswers[testState.currentQuestion] = e.target.value;
    });
  });
}

function updateProgress() {
  const filled = ((testState.currentQuestion + 1) / testState.numQuestions) * 100;
  document.getElementById('progress-fill').style.width = filled + '%';
  document.getElementById('progress-info').textContent = `Question ${testState.currentQuestion + 1} of ${testState.numQuestions}`;
}

function startTimer() {
  const timerInterval = setInterval(() => {
    const elapsed = Math.floor((Date.now() - testState.startTime) / 1000);
    const remaining = testState.duration - elapsed;

    if (remaining <= 0) {
      clearInterval(timerInterval);
      submitTest();
      return;
    }

    const minutes = Math.floor(remaining / 60);
    const seconds = remaining % 60;
    document.getElementById('timer').textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
  }, 1000);
}

function submitTest() {
  testInProgress = false;
  disableTestSecurity();

  const questions = questionBank[testState.subject];
  let correctCount = 0;

  const resultHTML = testState.selectedAnswers
    .map((answer, idx) => {
      const question = questions[idx];
      const isCorrect = answer === question.answer;
      if (isCorrect) correctCount++;

      return `
      <div class="question-card ${isCorrect ? 'correct' : 'incorrect'}">
        <div class="question-meta">
          <span>Question ${idx + 1}</span>
          <span>${isCorrect ? '✓ Correct' : '✗ Incorrect'}</span>
        </div>
        <p>${question.question}</p>
        <p><strong>Your answer:</strong> ${answer || 'Not answered'}</p>
        <p><strong>Correct answer:</strong> ${question.answer}</p>
        <div class="explanation">
          <p><strong>Explanation:</strong> ${question.explanation}</p>
        </div>
      </div>
    `;
    })
    .join('');

  const score = ((correctCount / testState.numQuestions) * 100).toFixed(2);
  const testResultHTML = `
    <div class="result-score">${score}%</div>
    <div class="result-details">
      <div class="result-item">
        <div class="result-item-label">Correct</div>
        <div class="result-item-value">${correctCount}/${testState.numQuestions}</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Accuracy</div>
        <div class="result-item-value">${score}%</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Time Taken</div>
        <div class="result-item-value">${Math.floor((Date.now() - testState.startTime) / 1000)}s</div>
      </div>
    </div>
    <h3>Detailed Results</h3>
    ${resultHTML}
  `;

  document.getElementById('test-result').innerHTML = testResultHTML;
  document.getElementById('test-result').classList.remove('hidden');
  document.getElementById('submit-test').classList.add('hidden');
  document.getElementById('load-more').classList.remove('hidden');

  // Save stats
  saveStats(score, testState.numQuestions);
  updateStats();
}

function resetSession() {
  testInProgress = false;
  disableTestSecurity();
  testState = {
    currentQuestion: 0,
    selectedAnswers: [],
    subject: '',
    numQuestions: 0,
    startTime: null,
    duration: 0,
  };

  document.getElementById('test-container').classList.add('hidden');
  document.getElementById('test-form').innerHTML = '';
  document.getElementById('test-result').classList.add('hidden');
  document.getElementById('submit-test').classList.remove('hidden');
  document.getElementById('load-more').classList.add('hidden');
}

function loadMoreQuestions() {
  resetSession();
  document.getElementById('subject-select').value = testState.subject;
  document.getElementById('num-questions').value = testState.numQuestions;
}

// ==================== SECURITY FUNCTIONS ====================
function enableTestSecurity() {
  document.addEventListener('copy', preventAction);
  document.addEventListener('cut', preventAction);
  document.addEventListener('paste', preventAction);
  document.addEventListener('contextmenu', preventAction);
  document.addEventListener('keydown', preventCopyPasteKeys);
  document.addEventListener('keydown', preventDevTools);
  document.addEventListener('visibilitychange', handleVisibilityChange);

  if (document.body.requestFullscreen) {
    document.body.requestFullscreen().catch(() => {});
  }
}

function disableTestSecurity() {
  document.removeEventListener('copy', preventAction);
  document.removeEventListener('cut', preventAction);
  document.removeEventListener('paste', preventAction);
  document.removeEventListener('contextmenu', preventAction);
  document.removeEventListener('keydown', preventCopyPasteKeys);
  document.removeEventListener('keydown', preventDevTools);
  document.removeEventListener('visibilitychange', handleVisibilityChange);

  if (document.fullscreenElement) {
    document.exitFullscreen().catch(() => {});
  }
}

function preventAction(e) {
  if (testInProgress) {
    e.preventDefault();
  }
}

function preventCopyPasteKeys(e) {
  if (!testInProgress) return;
  if ((e.ctrlKey || e.metaKey) && (e.key === 'c' || e.key === 'v' || e.key === 'x' || e.key === 'a')) {
    e.preventDefault();
  }
}

function preventDevTools(e) {
  if (!testInProgress) return;
  if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && e.key === 'I') || (e.ctrlKey && e.key === 'u')) {
    e.preventDefault();
  }
}

function handleVisibilityChange() {
  if (!testInProgress) return;

  if (document.hidden) {
    tabSwitches++;
    if (tabSwitches >= maxTabSwitches) {
      terminateTest();
    }
  }
}

function terminateTest() {
  testInProgress = false;
  disableTestSecurity();

  document.getElementById('warning-message').textContent = `Your test has been terminated. You switched tabs ${tabSwitches} times.`;
  document.getElementById('security-warning').classList.remove('hidden');

  setTimeout(() => {
    document.getElementById('security-warning').classList.add('hidden');
    resetSession();
  }, 5000);
}

// ==================== STATS MANAGEMENT ====================
function saveStats(score, numQuestions) {
  let stats = JSON.parse(localStorage.getItem('testStats')) || {
    totalTests: 0,
    totalScore: 0,
    totalQuestions: 0,
  };

  stats.totalTests++;
  stats.totalScore += parseFloat(score);
  stats.totalQuestions += numQuestions;

  localStorage.setItem('testStats', JSON.stringify(stats));
}

function loadStats() {
  const stats = JSON.parse(localStorage.getItem('testStats')) || {
    totalTests: 0,
    totalScore: 0,
    totalQuestions: 0,
  };

  updateStats();
}

function updateStats() {
  const stats = JSON.parse(localStorage.getItem('testStats')) || {
    totalTests: 0,
    totalScore: 0,
    totalQuestions: 0,
  };

  document.getElementById('total-attempted').textContent = stats.totalTests;
  document.getElementById('avg-score').textContent = stats.totalTests > 0 ? (stats.totalScore / stats.totalTests).toFixed(1) + '%' : '0%';
  document.getElementById('questions-used').textContent = stats.totalQuestions;

  let totalQuestions = 0;
  Object.values(questionBank).forEach(subject => {
    totalQuestions += subject.length;
  });
  document.getElementById('unique-questions').textContent = totalQuestions;
}

// ==================== SCHEDULED TEST FUNCTIONS ====================
function displayAssignmentStatus() {
  const tests = sessionManager.getScheduledTests();
  let html = '';

  if (tests.length === 0) {
    html = '<p>No test assigned yet.</p>';
  } else {
    const now = new Date();
    let foundActive = false;

    for (const test of tests) {
      const testDateTime = new Date(test.date + 'T' + test.time);
      const testEndTime = new Date(testDateTime.getTime() + test.duration * 60000);

      let status = '';
      if (testDateTime <= now && now <= testEndTime) {
        status = 'active';
        foundActive = true;
      } else if (testDateTime > now) {
        status = 'upcoming';
      } else {
        status = 'past';
      }

      const statusBadgeColor = status === 'active' ? '#22c55e' : status === 'upcoming' ? '#f59e0b' : '#6b7280';
      const statusBadge = `<span style="color: ${statusBadgeColor}; font-weight: 600;">● ${status.toUpperCase()}</span>`;

      html += `
        <div class="scheduled-test-card ${status}">
          <div class="test-info">
            <h3>${test.subject}</h3>
            <p>📅 ${test.date} at ${test.time}</p>
            <p>⏱️ ${test.duration} minutes • ${test.numQuestions} questions</p>
            <p>${statusBadge}</p>
          </div>
          ${status === 'active' ? `<button class="action-button" onclick="startScheduledTest('${test.id}')">Start Test</button>` : ''}
        </div>
      `;
    }

    if (!foundActive) {
      html += '<p style="margin-top: 16px; color: #6b7280;">No active test at the moment.</p>';
    }
  }

  document.getElementById('schedule-status').innerHTML = html;
}

function startScheduledTest(testId) {
  const tests = sessionManager.getScheduledTests();
  const test = tests.find(t => t.id === testId);

  if (!test) return;

  testState.subject = test.subject;
  testState.numQuestions = test.numQuestions;
  testState.currentQuestion = 0;
  testState.selectedAnswers = new Array(test.numQuestions).fill(null);
  testState.startTime = Date.now();
  testState.duration = test.duration * 60;

  testInProgress = true;
  enableTestSecurity();

  // Navigate to mock test view
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('mock-test').classList.add('active');

  document.querySelectorAll('.nav-item').forEach(btn => btn.classList.remove('active'));
  document.querySelector('[data-view="mock-test"]').classList.add('active');

  document.getElementById('test-container').classList.remove('hidden');
  document.getElementById('test-form').innerHTML = '';
  document.getElementById('test-result').classList.add('hidden');

  displayQuestion();
  startTimer();
}

// ==================== ADMIN FUNCTIONS ====================
function handleAdminScheduleSubmit(e) {
  e.preventDefault();

  const testData = {
    subject: document.getElementById('admin-subject').value,
    date: document.getElementById('admin-date').value,
    time: document.getElementById('admin-time').value,
    duration: parseInt(document.getElementById('admin-duration').value),
    numQuestions: parseInt(document.getElementById('admin-questions').value),
  };

  if (!testData.subject || !testData.date || !testData.time) {
    alert('Please fill in all fields');
    return;
  }

  sessionManager.scheduleTest(testData);
  e.target.reset();
  displayAdminTests();
  displayAssignmentStatus();
}

function displayAdminTests() {
  const tests = sessionManager.getScheduledTests();
  const testsHtml = tests
    .map(test => {
      const testDateTime = new Date(test.date + 'T' + test.time);
      const now = new Date();
      const testEndTime = new Date(testDateTime.getTime() + test.duration * 60000);

      let status = '';
      if (testDateTime <= now && now <= testEndTime) {
        status = 'active';
      } else if (testDateTime > now) {
        status = 'upcoming';
      } else {
        status = 'past';
      }

      return `
        <div class="admin-test-card ${status}">
          <div class="test-info">
            <h3>${test.subject}</h3>
            <p>📅 ${test.date} at ${test.time}</p>
            <p>⏱️ ${test.duration} minutes • ${test.numQuestions} questions</p>
          </div>
          <div class="test-actions">
            <button class="action-button secondary" onclick="deleteAdminTest('${test.id}')">Delete</button>
          </div>
        </div>
      `;
    })
    .join('');

  document.getElementById('admin-tests-list').innerHTML = testsHtml || '<p>No tests assigned yet.</p>';
}

function deleteAdminTest(testId) {
  if (confirm('Are you sure you want to delete this test?')) {
    sessionManager.deleteScheduledTest(testId);
    displayAdminTests();
    displayAssignmentStatus();
  }
// ==================== DOM ELEMENTS ====
const navButtons = document.querySelectorAll('.nav-item');
const views = document.querySelectorAll('.view');
const aiButton = document.getElementById('start-ai');
const subjectSelect = document.getElementById('subject-select');
const numQuestionsSelect = document.getElementById('num-questions');
const startTestButton = document.getElementById('start-test');
const resetSessionButton = document.getElementById('reset-session');
const testContainer = document.getElementById('test-container');
const testForm = document.getElementById('test-form');
const testResult = document.getElementById('test-result');
const testTitle = document.getElementById('test-title');
const testDescription = document.getElementById('test-description');
const progressFill = document.getElementById('progress-fill');
const progressInfo = document.getElementById('progress-info');
const timerDisplay = document.getElementById('timer');
const submitTestButton = document.getElementById('submit-test');
const loadMoreButton = document.getElementById('load-more');

// Schedule test elements
const scheduleStatus = document.getElementById('schedule-status');
const scheduleForm = document.getElementById('schedule-form');
const scheduleSubject = document.getElementById('schedule-subject');
const scheduleDate = document.getElementById('schedule-date');
const scheduleTime = document.getElementById('schedule-time');
const scheduleDuration = document.getElementById('schedule-duration');
const scheduleQuestions = document.getElementById('schedule-questions');
const scheduledTestsList = document.getElementById('scheduled-tests-list');

// Admin elements
const adminLoginModal = document.getElementById('admin-login-modal');
const adminLoginForm = document.getElementById('admin-login-form');
const adminEmail = document.getElementById('admin-email');
const adminPassword = document.getElementById('admin-password');
const adminNavBtn = document.getElementById('admin-nav-btn');
const adminScheduleForm = document.getElementById('admin-schedule-form');
const adminSubject = document.getElementById('admin-subject');
const adminDate = document.getElementById('admin-date');
const adminTime = document.getElementById('admin-time');
const adminDuration = document.getElementById('admin-duration');
const adminQuestions = document.getElementById('admin-questions');
const adminTestsList = document.getElementById('admin-tests-list');
const adminLogoutBtn = document.getElementById('admin-logout-btn');

// ==================== STATE ====================
let sessionManager = new SessionManager();
let activeQuestions = [];
let startTime = 0;
let timerInterval = null;
let testInProgress = false;
let tabSwitches = 0;
let maxTabSwitches = 3; // Allow up to 3 tab switches before warning
let isAdminLoggedIn = false;
const ADMIN_CREDENTIALS = { email: 'admin@test.com', password: 'admin123' };

// ==================== UTILITY FUNCTIONS ===================="}
function showView(viewId) {
  views.forEach(view => {
    view.classList.toggle('active', view.id === viewId);
  });

  navButtons.forEach(button => {
    button.classList.toggle('active', button.dataset.view === viewId);
  });
}

function getUnusedQuestions(subject, count) {
  const usedIds = sessionManager.getUsedQuestionIds(subject);
  const allQuestions = questionBank[subject] || [];

  const unusedQuestions = allQuestions
    .map((q, index) => ({ ...q, id: index }))
    .filter(q => !usedIds.includes(q.id));

  if (unusedQuestions.length < count) {
    if (unusedQuestions.length > 0) {
      return unusedQuestions.slice(0, count);
    }
    sessionManager.resetSession(subject);
    return allQuestions.map((q, index) => ({ ...q, id: index })).slice(0, count);
  }

  return unusedQuestions
    .sort(() => Math.random() - 0.5)
    .slice(0, count);
}

function startTimer() {
  startTime = Date.now();
  timerInterval = setInterval(updateTimer, 1000);
}

function updateTimer() {
  const elapsed = Math.floor((Date.now() - startTime) / 1000);
  const minutes = Math.floor(elapsed / 60);
  const seconds = elapsed % 60;
  timerDisplay.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
}

function stopTimer() {
  if (timerInterval) {
    clearInterval(timerInterval);
    timerInterval = null;
  }
}

function createQuestionCard(question, index, total) {
  const wrapper = document.createElement('section');
  wrapper.className = 'question-card';

  const difficultyClass = `difficulty-${question.difficulty.toLowerCase()}`;

  wrapper.innerHTML = `
    <div class="question-meta">
      <span>Question ${index + 1} of ${total}</span>
      <span class="${difficultyClass}">${question.difficulty}</span>
    </div>
    <p>${question.question}</p>
    <div class="answer-group">
      ${question.options
        .map(
          (option, optionIndex) => `
            <label>
              <input type="radio" name="question-${index}" value="${option}" />
              <span>${option}</span>
            </label>
          `
        )
        .join('')}
    </div>
    <div class="explanation hidden" data-explanation-index="${index}">
      <strong>Explanation:</strong>
      <p>${question.explanation || 'No explanation available for this question.'}</p>
    </div>
  `;

  return wrapper;
}

function updateProgress() {
  const answeredCount = testForm.querySelectorAll('input[type="radio"]:checked').length;
  const totalCount = testForm.querySelectorAll('input[type="radio"]').length;
  const progress = (answeredCount / totalCount) * 100;

  progressFill.style.width = progress + '%';
  progressInfo.textContent = `Answered ${answeredCount} of ${totalCount}`;
}

// ==================== SECURITY FUNCTIONS ====================
function enableTestSecurity() {
  // Prevent copy-paste
  document.addEventListener('contextmenu', preventDefault);
  document.addEventListener('copy', preventDefault);
  document.addEventListener('paste', preventDefault);
  document.addEventListener('cut', preventDefault);
  document.addEventListener('selectstart', preventDefault);
  document.addEventListener('dragstart', preventDefault);

  // Prevent keyboard shortcuts
  document.addEventListener('keydown', preventCopyPasteKeys);

  // Monitor tab switching
  document.addEventListener('visibilitychange', handleVisibilityChange);

  // Enter fullscreen
  if (document.documentElement.requestFullscreen) {
    document.documentElement.requestFullscreen().catch(err => {
      console.log('Fullscreen not supported or denied:', err);
    });
  }

  testInProgress = true;
  tabSwitches = 0;
}

function disableTestSecurity() {
  // Remove security measures
  document.removeEventListener('contextmenu', preventDefault);
  document.removeEventListener('copy', preventDefault);
  document.removeEventListener('paste', preventDefault);
  document.removeEventListener('cut', preventDefault);
  document.removeEventListener('selectstart', preventDefault);
  document.removeEventListener('dragstart', preventDefault);
  document.removeEventListener('keydown', preventCopyPasteKeys);
  document.removeEventListener('visibilitychange', handleVisibilityChange);

  // Exit fullscreen
  if (document.exitFullscreen) {
    document.exitFullscreen().catch(err => console.log('Exit fullscreen error:', err));
  }

  testInProgress = false;
}

function preventDefault(e) {
  e.preventDefault();
  return false;
}

function preventCopyPasteKeys(e) {
  // Prevent Ctrl+C, Ctrl+V, Ctrl+X, Ctrl+A, F12, etc.
  if (e.ctrlKey && (e.key === 'c' || e.key === 'v' || e.key === 'x' || e.key === 'a')) {
    e.preventDefault();
    showSecurityWarning('Copy-paste operations are not allowed during the test.');
    return false;
  }
  if (e.key === 'F12' || (e.ctrlKey && e.shiftKey && e.key === 'I') || (e.ctrlKey && e.key === 'u')) {
    e.preventDefault();
    showSecurityWarning('Developer tools are disabled during the test.');
    return false;
  }
}

function handleVisibilityChange() {
  if (document.hidden && testInProgress) {
    tabSwitches++;
    if (tabSwitches >= maxTabSwitches) {
      showSecurityWarning('Test terminated due to multiple tab switches. Please contact your instructor.');
      terminateTest();
    } else {
      showSecurityWarning(`Warning: Tab switching detected (${tabSwitches}/${maxTabSwitches}). Please stay on this tab.`);
    }
  }
}

function showSecurityWarning(message) {
  const warning = document.createElement('div');
  warning.className = 'security-warning';
  warning.innerHTML = `
    <div class="warning-content">
      <h3>Security Alert</h3>
      <p>${message}</p>
      <button onclick="this.parentElement.parentElement.remove()">OK</button>
    </div>
  `;
  document.body.appendChild(warning);
}

function terminateTest() {
  disableTestSecurity();
  stopTimer();
  testContainer.classList.add('hidden');
  alert('Test has been terminated due to security violations.');
}

// ==================== SCHEDULE TEST FUNCTIONS ====================
function handleScheduleSubmit(event) {
  event.preventDefault();

  const testData = {
    subject: scheduleSubject.value,
    date: scheduleDate.value,
    time: scheduleTime.value,
    duration: parseInt(scheduleDuration.value),
    numQuestions: parseInt(scheduleQuestions.value),
  };

  const scheduledTest = sessionManager.scheduleTest(testData);
  displayAssignmentStatus();

  // Reset form
  if (scheduleForm) {
    scheduleForm.reset();
  }

  alert(`Test scheduled successfully for ${subjectData[testData.subject]} on ${testData.date} at ${testData.time}`);
}

function displayAssignmentStatus() {
  if (!scheduleStatus) return;

  const tests = sessionManager.getScheduledTests();
  const now = new Date();
  const activeTest = tests.find(test => {
    const testDateTime = new Date(`${test.date}T${test.time}`);
    return testDateTime <= now && testDateTime >= new Date(now.getTime() - test.duration * 60000);
  });

  if (activeTest) {
    scheduleStatus.innerHTML = `
      <div class="assignment-message">
        <p>A test has been assigned and is available now.</p>
        <button id="start-assigned-test" class="action-button">Start Assigned Test</button>
      </div>
    `;
    const startButton = document.getElementById('start-assigned-test');
    if (startButton) {
      startButton.addEventListener('click', () => startScheduledTest(activeTest.id));
    }
    return;
  }

  const upcomingTest = tests.find(test => new Date(`${test.date}T${test.time}`) > now);
  if (upcomingTest) {
    scheduleStatus.textContent = 'A test has been assigned and will start soon.';
    return;
  }

  scheduleStatus.textContent = 'No test has been assigned yet.';
}

function startScheduledTest(testId) {
  const test = sessionManager.scheduledTests.find(t => t.id === testId);
  if (!test) return;

  // Set the subject and number of questions
  subjectSelect.value = test.subject;
  numQuestionsSelect.value = test.numQuestions;

  // Switch to mock test view and start
  showView('mock-test');
  loadTest();
}

function deleteScheduledTest(testId) {
  if (confirm('Are you sure you want to delete this scheduled test?')) {
    sessionManager.deleteScheduledTest(testId);
    displayAssignmentStatus();
  }
}

function renderTest(questions) {
  testTitle.textContent = `${subjectData[subjectSelect.value]} - Mock Test`;
  testDescription.textContent = `Answer ${questions.length} questions. Each correct answer is worth ${(100 / questions.length).toFixed(1)} points.`;
  testForm.innerHTML = '';
  testResult.classList.add('hidden');
  activeQuestions = questions;

  questions.forEach((question, index) => {
    const card = createQuestionCard(question, index, questions.length);
    testForm.appendChild(card);
  });

  submitTestButton.classList.remove('hidden');
  submitTestButton.disabled = false;
  submitTestButton.textContent = 'Submit Test';
  loadMoreButton.classList.add('hidden');

  testContainer.classList.remove('hidden');
  updateProgress();
  startTimer();
  enableTestSecurity(); // Enable security measures
  window.scrollTo(0, testContainer.offsetTop - 100);
}

function evaluateTest(event) {
  event.preventDefault();
  stopTimer();
  disableTestSecurity(); // Disable security measures

  const questions = testForm.querySelectorAll('.question-card');
  let score = 0;
  let answeredCount = 0;

  questions.forEach((card, index) => {
    const selected = card.querySelector('input[type="radio"]:checked');
    const explanationBlock = card.querySelector('.explanation');

    const correctAnswer = activeQuestions[index].answer;
    const labels = Array.from(card.querySelectorAll('label'));

    labels.forEach(label => {
      const input = label.querySelector('input[type="radio"]');
      if (!input) return;
      const optionValue = input.value;
      input.disabled = true;
      label.classList.remove('correct', 'incorrect');

      if (optionValue === correctAnswer) {
        label.classList.add('correct');
      }
      if (selected && optionValue === selected.value && selected.value !== correctAnswer) {
        label.classList.add('incorrect');
      }
    });

    if (selected) {
      answeredCount++;
      const selectedValue = selected.value;
      if (selectedValue === correctAnswer) {
        score++;
        card.classList.add('correct');
      } else {
        card.classList.add('incorrect');
      }
    } else {
      card.classList.add('incorrect');
    }

    if (explanationBlock) {
      explanationBlock.classList.remove('hidden');
    }
  });

  submitTestButton.disabled = true;
  submitTestButton.textContent = 'Submitted';
  loadMoreButton.classList.remove('hidden');

  const timeElement = timerDisplay.textContent;
  const percentage = Math.round((score / questions.length) * 100);

  sessionManager.recordTestAttempt(score, questions.length);

  testResult.innerHTML = `
    <div class="result-score">${score} / ${questions.length} (${percentage}%)</div>
    <div class="result-details">
      <div class="result-item">
        <div class="result-item-label">Questions Answered</div>
        <div class="result-item-value">${answeredCount} / ${questions.length}</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Time Taken</div>
        <div class="result-item-value">${timeElement}</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Accuracy</div>
        <div class="result-item-value">${percentage}%</div>
      </div>
      <div class="result-item">
        <div class="result-item-label">Performance</div>
        <div class="result-item-value">${percentage >= 80 ? '🎯 Excellent' : percentage >= 60 ? '✓ Good' : '⚠ Fair'}</div>
      </div>
    </div>
  `;
  testResult.classList.remove('hidden');
  updateStats();
}

function updateStats() {
  const stats = sessionManager.getStats();
  document.getElementById('total-attempted').textContent = stats.totalAttempted;
  document.getElementById('avg-score').textContent = stats.avgScore + '%';
  document.getElementById('questions-used').textContent = stats.totalUsed;
  document.getElementById('unique-questions').textContent = stats.uniqueAvailable;
}

function loadTest() {
  const subject = subjectSelect.value;
  const numQuestions = parseInt(numQuestionsSelect.value);
  const questions = getUnusedQuestions(subject, numQuestions);

  if (questions.length === 0) {
    alert('No questions available for this subject. Please reset the session.');
    return;
  }

  const questionIds = questions.map(q => q.id);
  sessionManager.markQuestionsAsUsed(subject, questionIds);

  const questionsToRender = questions.map(({ id, ...q }) => q);
  renderTest(questionsToRender);
}

// ==================== EVENT LISTENERS ====================
navButtons.forEach(button => {
  button.addEventListener('click', () => {
    showView(button.dataset.view);
    if (button.dataset.view === 'schedule-test') {
      displayAssignmentStatus();
    }
  });
});

startTestButton.addEventListener('click', loadTest);
resetSessionButton.addEventListener('click', () => {
  const subject = subjectSelect.value;
  sessionManager.resetSession(subject);
  alert(`Progress for ${subjectData[subject]} has been reset. You can take the test again.`);
  updateStats();
});

testForm.addEventListener('submit', evaluateTest);
testForm.addEventListener('change', updateProgress);
submitTestButton.addEventListener('click', () => testForm.requestSubmit());
loadMoreButton.addEventListener('click', loadTest);

if (aiButton) {
  aiButton.addEventListener('click', () => {
    alert('AI Interview simulation started!');
  });
}

// Schedule form event listener
if (scheduleForm) {
  scheduleForm.addEventListener('submit', handleScheduleSubmit);
}

// ==================== ADMIN FUNCTIONS ====================
function openAdminLogin() {
  adminLoginModal.classList.remove('hidden');
}

function closeAdminLogin() {
  adminLoginModal.classList.add('hidden');
  adminEmail.value = '';
  adminPassword.value = '';
}

function handleAdminLogin(event) {
  event.preventDefault();
  const email = adminEmail.value;
  const password = adminPassword.value;

  if (email === ADMIN_CREDENTIALS.email && password === ADMIN_CREDENTIALS.password) {
    isAdminLoggedIn = true;
    closeAdminLogin();
    adminNavBtn.classList.remove('hidden');
    showView('admin');
    displayAdminTests();
  } else {
    alert('Invalid credentials. Please try again.');
  }
}

function handleAdminLogout() {
  if (confirm('Are you sure you want to logout?')) {
    isAdminLoggedIn = false;
    adminNavBtn.classList.add('hidden');
    showView('dashboard');
  }
}

function handleAdminScheduleSubmit(event) {
  event.preventDefault();

  const testData = {
    subject: adminSubject.value,
    date: adminDate.value,
    time: adminTime.value,
    duration: parseInt(adminDuration.value),
    numQuestions: parseInt(adminQuestions.value),
  };

  const scheduledTest = sessionManager.scheduleTest(testData);
  displayAdminTests();
  adminScheduleForm.reset();
  alert(`Test scheduled successfully for ${subjectData[testData.subject]} on ${testData.date} at ${testData.time}`);
}

function displayAdminTests() {
  const tests = sessionManager.getScheduledTests();

  if (tests.length === 0) {
    adminTestsList.innerHTML = '<p>No tests assigned yet.</p>';
    return;
  }

  const testsHTML = tests.map(test => {
    const testDateTime = new Date(`${test.date}T${test.time}`);
    const now = new Date();
    const isActive = testDateTime <= now && testDateTime >= new Date(now.getTime() - test.duration * 60000);
    const isUpcoming = testDateTime > now;

    return `
      <div class="admin-test-card ${isActive ? 'active' : isUpcoming ? 'upcoming' : 'past'}">
        <div class="test-info">
          <h3>${subjectData[test.subject]}</h3>
          <p><strong>Date:</strong> ${test.date}</p>
          <p><strong>Time:</strong> ${test.time}</p>
          <p><strong>Duration:</strong> ${test.duration} minutes</p>
          <p><strong>Questions:</strong> ${test.numQuestions}</p>
          <p><strong>Status:</strong> ${isActive ? 'Active' : isUpcoming ? 'Upcoming' : 'Past'}</p>
        </div>
        <div class="test-actions">
          <button onclick="deleteAdminTest('${test.id}')" class="action-button secondary">Delete</button>
        </div>
      </div>
    `;
  }).join('');

  adminTestsList.innerHTML = testsHTML;
}

function deleteAdminTest(testId) {
  if (confirm('Are you sure you want to delete this test?')) {
    sessionManager.deleteScheduledTest(testId);
    displayAdminTests();
  }
}

// Admin event listeners
if (adminLoginForm) {
  adminLoginForm.addEventListener('submit', handleAdminLogin);
}

if (adminLogoutBtn) {
  adminLogoutBtn.addEventListener('click', handleAdminLogout);
}

if (adminScheduleForm) {
  adminScheduleForm.addEventListener('submit', handleAdminScheduleSubmit);
}

updateStats();

